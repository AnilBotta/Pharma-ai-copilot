# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the whole point of having one. The blanket
# rule above swallowed it, so `.env.example` has never been in the repository -
# while the application's own startup error tells you to "Copy .env.example to
# .env.local". Anyone cloning this had to reconstruct the variable list from
# app/config.py.
#
# It contains placeholders only, and a `git check-ignore -v .env.example` will
# now report this line rather than the one above.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
backend/.venv/
backend/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/

# local uploads / scratch
backend/uploads/
backend/.cache/

# Design canvas build output. The .dc.html artboards and canvas.json in
# design/ ARE the source and are tracked; this is the ~2 MB seeded page
# assembled from them, regenerated on every change.
design/pharma-copilot-instrument.html
