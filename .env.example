# =============================================================================
# Pharma R&D Copilot — environment variables
# =============================================================================
# Copy this file to `.env.local` (frontend) and `backend/.env` (backend) and
# fill in real values. This file contains PLACEHOLDERS ONLY — never commit real
# credentials. `.gitignore` excludes all `.env*` files except this one.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# PUBLIC. Never give a secret that prefix.
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND  →  .env.local
# -----------------------------------------------------------------------------

# Supabase project URL and anon (publishable) key.
# The anon key is designed to be public and is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the API lives.
#
# LOCAL: the backend runs separately on port 8000, so set it explicitly.
# DEPLOYED: leave it UNSET. The Python function serves /api/* on the same
# domain, so requests go same-origin and there is no CORS to configure.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# BACKEND  →  backend/.env      (SERVER-ONLY — never NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Supabase Postgres pooled connection string (Project Settings → Database).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase server-side -----------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — full database access, bypasses RLS. Treat as a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Usually NOT needed. Current Supabase projects sign JWTs with asymmetric
# ES256/RS256 keys published at /auth/v1/.well-known/jwks.json, which the
# backend fetches automatically — no shared secret required.
# Set this only for legacy projects that still use an HS256 shared secret.
# Check yours:  curl https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# A non-empty "keys" array means you can leave this blank.
SUPABASE_JWT_SECRET=

# --- OpenAI (REQUIRED — no agent can run without this) ------------------------
OPENAI_API_KEY=sk-your-openai-api-key

# Per-role model selection. No model is hardcoded anywhere in the source.
# Cheaper models are appropriate for extraction; reserve stronger models for
# synthesis and verification.
OPENAI_MODEL_SUPERVISOR=gpt-5
OPENAI_MODEL_RESEARCH=gpt-5
OPENAI_MODEL_EXTRACTION=gpt-5-mini
OPENAI_MODEL_SYNTHESIS=gpt-5
OPENAI_MODEL_VERIFICATION=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Request behaviour
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3

# --- Literature providers -----------------------------------------------------
# PubMed / NCBI E-utilities.
# Works WITHOUT a key at 3 requests/second. With a key: 10 requests/second.
# NCBI_EMAIL is required by NCBI usage policy for identification.
NCBI_API_KEY=your-ncbi-api-key
NCBI_EMAIL=you@example.com

# Europe PMC requires no credentials.

# Optional metadata enrichment. Both work keyless; providing contact details
# opts you into the faster "polite pool".
CROSSREF_MAILTO=you@example.com
OPENALEX_API_KEY=

# --- Patent providers ---------------------------------------------------------
# EPO Open Patent Services — REQUIRED for patent retrieval.
# Free registration at https://developers.epo.org (4 GB/month quota).
# Without these the Patent Agent reports an honest integration error and the
# run continues on literature evidence alone. It never fabricates results.
EPO_OPS_CONSUMER_KEY=your-epo-ops-consumer-key
EPO_OPS_CONSUMER_SECRET=your-epo-ops-consumer-secret

# Optional secondary patent source.
USPTO_API_KEY=

# --- Runtime limits -----------------------------------------------------------
MAX_LITERATURE_RESULTS=50
MAX_PATENT_RESULTS=30
MAX_UPLOAD_SIZE_MB=25
PROVIDER_CACHE_TTL_SECONDS=86400
RUN_TIMEOUT_SECONDS=1800

# --- Worker ---------------------------------------------------------------------
# Only needed when the worker runs on a host that kills long invocations
# (Vercel and friends). A long-lived `python -m app.worker` needs none of this.

# Shared secret for POST /api/worker/tick, which is called by the database
# scheduler and by the deployment itself. That endpoint spends money on model
# calls, so with this unset it refuses every request rather than defaulting to
# open. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The SAME value must go into the database:
#   alter database postgres set app.worker_tick_secret = '<value>';
WORKER_TRIGGER_SECRET=

# Elapsed seconds after which a slice stops taking on ANOTHER node. It does not
# interrupt a node already running, so the worst case is
# budget + longest_node, and THAT is what must fit the host's function timeout.
#
# Measured on a real run, the longest single node is ~120 s.
#   0    long-lived process: no slicing (the default)
#   150  Vercel Hobby   — worst case ~280 s against a hard 300 s ceiling
#   600  Vercel Pro     — worst case ~720 s against 800 s
WORKER_SLICE_BUDGET_SECONDS=0

# The deployment's own public origin, needed because a slice triggers its
# successor over HTTP and a serverless invocation cannot discover its own URL.
# It is also what makes alert emails clickable, so without it they name a
# requirement and give you no way to reach it.
# NEXT_PUBLIC_SITE_URL is accepted as the same value.
# e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=

# --- Notifications ---------------------------------------------------------------
# Absent means alerts are still computed, recorded and shown in the UI — only
# the email is skipped, and each delivery row says so rather than silently
# doing nothing. Nothing is lost either way: a notification points at state
# that lives in the database.
#
# BOTH of the next two are required. With either missing nothing is sent, so a
# near-miss on one name disables alerts entirely rather than degrading them.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=alerts@yourdomain.com   # RESEND_FROM_EMAIL also accepted

# Optional. Alerts are sent from a no-reply address; without this, somebody
# replying to one is talking to nobody.
EMAIL_REPLY_TO=

# --- Application --------------------------------------------------------------
# Comma-separated origins permitted to call the API.
# Deployed on one domain this is irrelevant: the frontend calls /api/* on its
# own origin, so no cross-origin request is made at all.
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ENVIRONMENT=development
